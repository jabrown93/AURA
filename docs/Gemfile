source "https://rubygems.org"

#     bundle exec jekyll serve

gem "jekyll", "~> 4.4"
gem "just-the-docs", "~> 0.12"

# Required by just-the-docs; the github-pages gem used to supply these implicitly.
group :jekyll_plugins do
  gem "jekyll-include-cache"
  gem "jekyll-seo-tag", "~> 2.8"
  # Rewrites .md links in source so they work both on github.com and on the
  # rendered site. index.md relies on this.
  gem "jekyll-relative-links"
end

